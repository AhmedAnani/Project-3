{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [ "src/*" ],
      "@assets/*": [ "../attached_assets/*" ],
      "@workspace/api-client-react": [ "src/lib/api-client.ts" ] // 👈 ADD THIS
    },
    "types": [ "vite/client", "node" ]
  },
  "include": [ "src/**/*", "vite.config.ts" ]
}